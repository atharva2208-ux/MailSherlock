# --- Server ---------------------------------------------------------------
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
# Allowed browser origin for the API (the Vite dev server in development)
CORS_ORIGIN=http://localhost:5173
# SQLite database file (created automatically)
DATABASE_PATH=./var/mailsherlock.sqlite
# Maximum accepted email size in bytes (default 10 MiB)
MAX_EMAIL_BYTES=10485760
# Whether raw email source is stored for the forensic raw viewer
STORE_RAW_SOURCE=true

# --- ML inference service -------------------------------------------------
# The Python inference service (npm run ml:serve). Analysis continues with
# rule-based detection only when it is unreachable.
ML_SERVICE_URL=http://127.0.0.1:8001
ML_TIMEOUT_MS=4000

# --- Threat intelligence (all optional) -----------------------------------
# No external service is contacted unless it is configured here.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLSCAN_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
# RDAP needs no key, but is opt-in because it sends domains to rdap.org
RDAP_ENABLED=false
# Query configured providers automatically for every analysis
ENRICH_ON_ANALYZE=false
THREAT_INTEL_TIMEOUT_MS=5000
